          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number",
            "description": "Physical serial number stamped on the meter"
          },
          "make": {
            "type": "string",
            "title": "Make",
            "description": "Meter manufacturer (e.g., HPL, Secure, Genus)"

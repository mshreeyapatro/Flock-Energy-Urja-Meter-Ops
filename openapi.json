              {
                "$ref": "#/components/schemas/HierarchyLevel"
              },
              {
                "type": "null"
              }
            ],
            "description": "Division level entity"
          },
          "subdivision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HierarchyLevel"
              },
              {
                "type": "null"
              }
            ],
            "description": "Subdivision level entity"
          },
          "substation": {
            "anyOf": [

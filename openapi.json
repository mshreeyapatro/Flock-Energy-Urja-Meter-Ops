            },
            "type": "array",
            "title": "Breadcrumbs",
            "description": "Ordered breadcrumb path from Zone to DT"
          }
        },
        "type": "object",
        "title": "MeterHierarchy"
      },
      "MeterListResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total count of meters matching query across all pages"
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "Current page number"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size",

{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy - Urja Meter Ops API",
    "description": "Enterprise-grade REST API proxy and data normalization service for the legacy Urja Meter Ops portal. Provides automated session persistence, structured JSON models, consumption analytics, and network hierarchy mappings.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "System Healthcheck",
        "description": "Returns service status, downstream Urja portal connectivity, and authentication state.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Portal Authentication",
        "description": "Authenticates against the legacy Urja portal using operator credentials. Establishes a persistent cookie session and returns authentication status. If no credentials are provided in the payload, default configured credentials are used.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LoginRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Req"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/status": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authentication Session Status",
        "description": "Checks whether the API wrapper has an active session with the legacy portal.",
        "operationId": "get_auth_status_api_v1_auth_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List and Search Smart Meters",
        "description": "Retrieves a paginated list of smart meters. Supports query parameter `q` to search across meter IDs and serial numbers.",
        "operationId": "list_meters_api_v1_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Search query by meter ID or serial number",
              "default": "",
              "title": "Q"
            },
            "description": "Search query by meter ID or serial number"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-indexed)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get Meter Details",
        "description": "Fetches granular metadata for a specific meter ID. Parses server-side rendered HTML nameplate specifications, retrieves normalized GPS coordinates, and reconstructs the grid hierarchy (Zone -> Feeder -> DT).",
        "operationId": "get_meter_by_id_api_v1_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get Meter Consumption History",
        "description": "Retrieves time-series energy consumption readings for a meter. Normalizes string metrics to numeric floating point values (kWh, kVAh, Voltage) and computes dataset summary statistics (min/max kWh, voltage range, latest reading).",
        "operationId": "get_meter_consumption_api_v1_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterConsumptionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "tags": [
          "Hierarchy"
        ],
        "summary": "Retrieve Electrical Grid Hierarchy",
        "description": "Builds and returns an organized network hierarchy tree mapping distribution transformers, feeders, and their connected smart meters.",
        "operationId": "get_hierarchy_api_v1_hierarchy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HierarchyTreeResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthStatus": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated",
            "description": "Whether a valid session is currently established"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Logged in operator email"
          },
          "user_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Name",
            "description": "Logged in operator display name"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Authentication status message"
          }
        },
        "type": "object",
        "required": [
          "authenticated",
          "message"
        ],
        "title": "AuthStatus"
      },
      "ConsumptionReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "Reading timestamp in standardized format"
          },
          "kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kwh",
            "description": "Active energy in kilowatt-hours (kWh)"
          },
          "kvah": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kvah",
            "description": "Apparent energy in kilovolt-ampere-hours (kVAh)"
          },
          "volt_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volt R",
            "description": "R-phase voltage in Volts (V)"
          }
        },
        "type": "object",
        "required": [
          "timestamp"
        ],
        "title": "ConsumptionReading"
      },
      "ConsumptionSummary": {
        "properties": {
          "total_readings": {
            "type": "integer",
            "title": "Total Readings",
            "description": "Count of readings in history"
          },
          "latest_reading": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConsumptionReading"
              },
              {
                "type": "null"
              }
            ],
            "description": "Most recent timestamp reading"
          },
          "min_kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Kwh",
            "description": "Minimum recorded active energy"
          },
          "max_kwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Kwh",
            "description": "Maximum recorded active energy"
          },
          "min_volt_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Volt R",
            "description": "Minimum recorded voltage"
          },
          "max_volt_r": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Volt R",
            "description": "Maximum recorded voltage"
          }
        },
        "type": "object",
        "required": [
          "total_readings"
        ],
        "title": "ConsumptionSummary"
      },
      "GeoLocation": {
        "properties": {
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude",
            "description": "Normalized GPS Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude",
            "description": "Normalized GPS Longitude"
          }
        },
        "type": "object",
        "title": "GeoLocation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Service status (e.g. healthy)"
          },
          "portal_connected": {
            "type": "boolean",
            "title": "Portal Connected",
            "description": "Whether downstream Urja portal is responsive"
          },
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated",
            "description": "Whether valid session cookies are active"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "API service version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "portal_connected",
          "authenticated",
          "version"
        ],
        "title": "HealthResponse"
      },
      "HierarchyLevel": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Name of the administrative or technical entity"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code",
            "description": "Unique code of the entity"
          }
        },
        "type": "object",
        "title": "HierarchyLevel"
      },
      "HierarchyTreeResponse": {
        "properties": {
          "total_transformers": {
            "type": "integer",
            "title": "Total Transformers",
            "description": "Total distribution transformers indexed"
          },
          "transformers": {
            "items": {
              "$ref": "#/components/schemas/TransformerItem"
            },
            "type": "array",
            "title": "Transformers",
            "description": "List of distribution transformers"
          },
          "tree": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tree",
            "description": "Hierarchical tree grouped by Zone -> Feeder -> DT"
          }
        },
        "type": "object",
        "required": [
          "total_transformers",
          "transformers",
          "tree"
        ],
        "title": "HierarchyTreeResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Operator email address"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username",
            "description": "Alternative alias for email"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Operator password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeterConsumptionResponse": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id",
            "description": "Target meter identifier"
          },
          "summary": {
            "$ref": "#/components/schemas/ConsumptionSummary",
            "description": "Aggregated analytics across the dataset"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ConsumptionReading"
            },
            "type": "array",
            "title": "Readings",
            "description": "Time-series consumption data points"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "summary",
          "readings"
        ],
        "title": "MeterConsumptionResponse"
      },
      "MeterDetailResponse": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id",
            "description": "Unique meter identifier"
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number",
            "description": "Physical serial number"
          },
          "make": {
            "type": "string",
            "title": "Make",
            "description": "Manufacturer"
          },
          "phase_type": {
            "type": "string",
            "title": "Phase Type",
            "description": "Phase type"
          },
          "install_status": {
            "type": "string",
            "title": "Install Status",
            "description": "Current operational status"
          },
          "install_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Install Type",
            "description": "Installation type (e.g., Whole Current, LT-CT)"
          },
          "build": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build",
            "description": "Hardware build specification"
          },
          "dt_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dt Code",
            "description": "Distribution Transformer code"
          },
          "geo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoLocation"
